# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environment and secrets
.venv/
.env

# IDE
.vscode/
.idea/

# Large data and generated outputs (Git tracks only code and configuration)
# Ignore files under data/, retain directories, and track .gitkeep placeholders.
data/**/*
!data/**/
!data/**/.gitkeep

checkpoints/
*.pt
*.pth

# Logs and generated reports
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep
!reports/stage-1-data-foundation.md

# Local database and auxiliary files
*.db
*.db-journal
*.db-wal
*.db-shm
